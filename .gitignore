# Dependencies
node_modules/

# Build output
dist/
coverage/
*.tsbuildinfo

# Data: the upstream files (data/raw/) are committed; the datasets built from them are not, since
# `npm run dev` and `npm run build` rebuild them (see README.md → "Data").
public/data/
# Except this one: 4.4 MB of archive for one translation is not worth keeping in the repository,
# so the build downloads it on demand and checks it against its pin in data/sources.json.
data/raw/eng-kjv2006_vpl.zip
# And these: 96 MB of tagged Hebrew and Greek, which STEPBible asks to be fetched from them
# rather than passed on second-hand. The build downloads them against their pins too.
data/raw/stepbible-*.txt

# Test output: Playwright's traces, screenshots and report, and the Vitest cache.
test-results/
playwright-report/
.vitest/

# Logs
*.log
npm-debug.log*

# Local environment
*.local
.env
.env.*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Sandbox sources, downloaded against their pins in data/sources.json rather than kept here.
data/raw/eng-asv_vpl.zip
data/raw/engwebp_vpl.zip
data/raw/engmsb_vpl.zip
data/raw/strongs-*.js
data/raw/lxx-*.js
data/raw/eng-kjv2006_usfm.zip
data/raw/bdb-*.xml
data/raw/thayer_lexicon.json

# Licensed translations the owner supplies (the NASB, The Lockman Foundation): the source file and
# anything built from it never go in git.
data/private/
public/data/translations/nasb.json
